@inproceedings{10.5555/3692070.3693515,
author = {Merth, Thomas and Fu, Qichen and Rastegari, Mohammad and Najibi, Mahyar},
title = {Superposition prompting: improving and accelerating retrieval-augmented generation},
year = {2024},
publisher = {JMLR.org},
abstract = {Despite the successes of large language models (LLMs), they exhibit significant drawbacks, particularly when processing long contexts. Their inference cost scales quadratically with respect to sequence length, making it expensive for deployment in some real-world text processing applications, such as retrieval-augmented generation (RAG). Additionally, LLMs also exhibit the "distraction phenomenon", where irrelevant context in the prompt degrades output quality. To address these drawbacks, we propose a novel RAG prompting methodology, superposition prompting, which can be directly applied to pretrained transformer-based LLMs without the need for fine-tuning. At a high level, superposition prompting allows the LLM to process input documents in parallel prompt paths, discarding paths once they are deemed irrelevant. We demonstrate the capability of our method to simultaneously enhance time efficiency across a variety of question-answering benchmarks using multiple pretrained LLMs. Furthermore, our technique significantly improves accuracy when the retrieved context is large relative the context the model was trained on. For example, our approach facilitates an 93\texttimes{} reduction in compute time while improving accuracy by 43\% on the NaturalQuestions-Open dataset with the MPT-7B instruction-tuned model over naive RAG.},
booktitle = {Proceedings of the 41st International Conference on Machine Learning},
articleno = {1445},
numpages = {21},
location = {Vienna, Austria},
series = {ICML'24}
}

